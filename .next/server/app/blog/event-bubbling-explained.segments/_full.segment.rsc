1a:["$","ol","52",{"children":["\n",["$","li","1",{"children":[["$","strong","0",{"children":["Event starts"]}]," at the target element."]}],"\n",["$","li","3",{"children":["Then ",["$","strong","1",{"children":["moves upward"]}]," through parents."]}],"\n",["$","li","5",{"children":["This behavior is called ",["$","strong","1",{"children":["Event Bubbling"]}],"."]}],"\n",["$","li","7",{"children":["It is useful for ",["$","strong","1",{"children":["Event Delegation"]}],"."]}],"\n",["$","li","9",{"children":["It can be stopped using ",["$","code","1",{"children":["e.stopPropagation()"]}],"."]}],"\n"]}]
