on that element and then ",["$","strong","1",{"children":["“bubbles up”"]}]," to its parents, one by one."]}],"\n",["$","p","8",{"children":["Think of it like this:\n👉 ",["$","strong","1",{"children":["You tap a glass on a table"]}]," → the glass feels it → the table feels it → the floor feels it."]}],"\n",["$","h2","10",{"children":["Simple Example (HTML + JS)"]}],"\n",["$","p","12",{"children":["Consider this structure:"]}],"\n",["$","pre","14",{"children":[["$","code","0",{"className":"language-html","children":["<div id=\"parent\">\n  Parent\n  <button id=\"child\">Click me</button>\n</div>\n"]}]]}],"\n",["$","p","16",{"children":["And this JavaScript:"]}],"\n",["$","pre","18",{"children":[["$","code","0",{"className":"language-javascript","children":["document.getElementById(\"parent\").addEventListener(\"click\", () => {\n  console.log(\"Parent clicked\");\n});\n\ndocument.getElementById(\"child\").addEventListener(\"click\", () => {\n  console.log(\"Child clicked\");\n});\n"]}]]}],"\n",["$","h3","20",{"children":["What happens when you click the button?"]}],"\n",["$","p","22",{"children":[["$","strong","0",{"children":["Output:"]}]]}],"\n",["$","ol","24",{"children":["\n",["$","li","1",{"children":[["$","code","0",{"children":["Child clicked"]}]]}],"\n",["$","li","3",{"children":[["$","code","0",{"children":["Parent clicked"]}]]}],"\n"]}],"\n",["$","p","26",{"children":[["$","strong","0",{"children":["Why?"]}],"\nBecause the click starts at the ",["$","strong","2",{"children":["button"]}]," (child), then bubbles up to the ",["$","strong","4",{"children":["div"]}]," (parent)."]}],"\n",["$","hr","28",{}],"\n",["$","h2","30",{"children":["Real-Life Use Case: Why is this Useful? 🛠️"]}],"\n",["$","p","32",{"children":["Imagine you have a list of 100 items. Instead of adding click listeners to ",["$","strong","1",{"children":["100 list items"]}],", you can add just ",["$","strong","3",{"children":["one listener"]}]," to the parent ",["$","code","5",{"children":["<ul>"]}],"."]}],"\n",["$","pre","34",{"children":[["$","code","0",{"className":"language-javascript","children":["// Event Delegation\ndocument.getElementById(\"list\").addEventListener(\"click\", (e) => {\n  if (e.target.tagName === \"LI\") {\n    console.log(\"Item clicked:\", e.target.textContent);\n  }\n});\n"]}]]}],"\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e"]}]]}]}]
12:["$","p","36",{"children":["This pattern is called ",["$","strong","1",{"children":["Event Delegation"]}],", and it works entirely because of bubbling.\n✅ ",["$","strong","3",{"children":["Less code"]}],"\n✅ ",["$","strong","5",{"children":["Better performance"]}],"\n✅ ",["$","strong","7",{"children":["Easier maintenance"]}]]}]
13:["$","hr","38",{}]
14:["$","h2","40",{"children":["Stopping the Bubble 🛑"]}]
15:["$","p","42",{"children":["Sometimes you ",["$","strong","1",{"children":["don’t"]}]," want the event to go up. You can stop it!"]}]
16:["$","pre","44",{"children":[["$","code","0",{"className":"language-javascript","children":["document.getElementById(\"child\").addEventListener(\"click\", (e) => {\n  e.stopPropagation(); // <--- The magic line\n  console.log(\"Only child clicked\");\n});\n"]}]]}]
17:["$","p","46",{"children":["Now, if you click the child, the parent ",["$","strong","1",{"children":["won’t"]}]," react at all."]}]
