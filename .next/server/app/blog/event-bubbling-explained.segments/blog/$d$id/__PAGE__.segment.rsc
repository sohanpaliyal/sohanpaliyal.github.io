eans that when an event happens on a child element, it first runs on that element and then ",["$","strong","1",{"children":["“bubbles up”"]}]," to its parents, one by one."]}],"\n",["$","p","8",{"children":["Think of it like this:\n👉 ",["$","strong","1",{"children":["You tap a glass on a table"]}]," → the glass feels it → the table feels it → the floor feels it."]}],"\n",["$","h2","10",{"children":["Simple Example (HTML + JS)"]}],"\n",["$","p","12",{"children":["Consider this structure:"]}],"\n",["$","pre","14",{"children":[["$","code","0",{"className":"language-html","children":["<div id=\"parent\">\n  Parent\n  <button id=\"child\">Click me</button>\n</div>\n"]}]]}],"\n",["$","p","16",{"children":["And this JavaScript:"]}],"\n",["$","pre","18",{"children":[["$","code","0",{"className":"language-javascript","children":["document.getElementById(\"parent\").addEventListener(\"click\", () => {\n  console.log(\"Parent clicked\");\n});\n\ndocument.getElementById(\"child\").addEventListener(\"click\", () => {\n  console.log(\"Child clicked\");\n});\n"]}]]}],"\n",["$","h3","20",{"children":["What happens when you click the button?"]}],"\n",["$","p","22",{"children":[["$","strong","0",{"children":["Output:"]}]]}],"\n",["$","ol","24",{"children":["\n",["$","li","1",{"children":[["$","code","0",{"children":["Child clicked"]}]]}],"\n",["$","li","3",{"children":[["$","code","0",{"children":["Parent clicked"]}]]}],"\n"]}],"\n",["$","p","26",{"children":[["$","strong","0",{"children":["Why?"]}],"\nBecause the click starts at the ",["$","strong","2",{"children":["button"]}]," (child), then bubbles up to the ",["$","strong","4",{"children":["div"]}]," (parent)."]}],"\n",["$","hr","28",{}],"\n",["$","h2","30",{"children":["Real-Life Use Case: Why is this Useful? 🛠️"]}],"\n",["$","p","32",{"children":["Imagine you have a list of 100 items. Instead of adding click listeners to ",["$","strong","1",{"children":["100 list items"]}],", you can add just ",["$","strong","3",{"children":["one listener"]}]," to the parent ",["$","code","5",{"children":["<ul>"]}],"."]}],"\n",["$","pre","34",{"children":["$L5"]}],"\n","$L6","\n","$L7","\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12"]}]]}]}],["$L13"],"$L14"]}],"loading":null,"isPartial":false}
