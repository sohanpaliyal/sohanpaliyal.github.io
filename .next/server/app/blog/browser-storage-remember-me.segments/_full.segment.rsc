17:["$","ul","20",{"children":["\n",["$","li","1",{"children":[["$","strong","0",{"children":["Tab-scoped"]}],": Data stays within the specific tab where it was created."]}],"\n",["$","li","3",{"children":[["$","strong","0",{"children":["Cleared when tab closes"]}],": The data is automatically cleared when the page session ends (i.e., when the tab is closed)."]}],"\n",["$","li","5",{"children":[["$","strong","0",{"children":["Survives reloads"]}],": Data persists through page reloads and restores."]}],"\n"]}]
