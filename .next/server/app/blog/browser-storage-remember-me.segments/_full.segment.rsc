1a:["$","p","26",{"children":[["$","strong","0",{"children":["Cookies"]}]," are small blocks of data created by a web server while a user is browsing a website and placed on the user's computer or other device by the user's web browser."]}]
1b:["$","ul","28",{"children":["\n",["$","li","1",{"children":[["$","strong","0",{"children":["Sent with requests"]}],": Cookies are sent to the server with every HTTP request, making them useful for authentication."]}],"\n",["$","li","3",{"children":[["$","strong","0",{"children":["Expiration"]}],": Can be \"Session\" cookies (expire when the client shuts down) or \"Persistent\" cookies (expire at a specific date)."]}],"\n",["$","li","5",{"children":[["$","strong","0",{"children":["Security"]}],": Can be configured with flags like ",["$","code","2",{"children":["HttpOnly"]}]," (inaccessible to JavaScript), ",["$","code","4",{"children":["Secure"]}]," (HTTPS only), and ",["$","code","6",{"children":["SameSite"]}]," (CSRF protection)."]}],"\n"]}]
