20:["$","ol","38",{"children":["\n",["$","li","1",{"children":[["$","strong","0",{"children":["If \"Remember Me\" is checked"]}]," → The user stays logged in even after closing and reopening the browser."]}],"\n",["$","li","3",{"children":[["$","strong","0",{"children":["If \"Remember Me\" is UNCHECKED"]}]," → The user is logged out when the browser is closed."]}],"\n"]}]
21:["$","h3","40",{"children":["The Implementation Strategy"]}]
22:["$","p","42",{"children":["We combined two mechanisms:"]}]
23:["$","ol","44",{"children":["\n",["$","li","1",{"children":["A ",["$","strong","1",{"children":["Session Cookie"]}]," (no fixed expiry) — Serves as the active session identifier."]}],"\n",["$","li","3",{"children":["A ",["$","strong","1",{"children":["remember_me"]}]," flag in ",["$","code","3",{"children":["localStorage"]}]," — Indicates user intent for persistence."]}],"\n"]}]
24:["$","h4","46",{"children":["Step 1: On Login"]}]
25:["$","pre","48",{"children":[["$","code","0",{"className":"language-javascript","children":["localStorage.setItem(\"remember_me\", \"false\"); // Stores user preference\ndocument.cookie = \"active_session=true; path=/\"; // Sets the session cookie\n"]}]]}]
26:["$","h4","50",{"children":["Step 2: On App Initialization"]}]
27:["$","pre","52",{"children":[["$","code","0",{"className":"language-javascript","children":["const rememberMe = localStorage.getItem(\"remember_me\");\nconst hasSessionCookie = document.cookie.includes(\"active_session=true\");\n\nif (rememberMe !== \"true\" && !hasSessionCookie) {\n  logoutUser(); // Clears session if specific criteria aren't met\n}\n"]}]]}]
28:["$","p","54",{"children":[["$","em","0",{"children":["Logic"]}],": If the user did not opt for \"Remember Me\" AND the session cookie is missing (indicating a fresh browser session), the application logs the user out."]}]
