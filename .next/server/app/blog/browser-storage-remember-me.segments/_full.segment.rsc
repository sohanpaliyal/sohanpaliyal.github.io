2d:["$","p","64",{"children":["An interesting edge case arises with the \"Restore Closed Tab\" feature found in modern browsers."]}]
2e:["$","p","66",{"children":["If a user unchecks \"Remember Me\", closes the browser, and then uses ",["$","strong","1",{"children":["Cmd + Shift + T"]}]," (or Ctrl + Shift + T) to restore the tab, they will often find themselves still logged in."]}]
2f:["$","h3","68",{"children":["Why Does This Happen?"]}]
30:["$","p","70",{"children":["Modern browsers treat \"Tab Restore\" as a continuation of the previous session rather than a fresh start."]}]
31:["$","ul","72",{"children":["\n",["$","li","1",{"children":[["$","strong","0",{"children":["Session cookies"]}]," are restored."]}],"\n",["$","li","3",{"children":[["$","strong","0",{"children":["Application state"]}]," is preserved."]}],"\n",["$","li","5",{"children":["From the application's perspective, the session never actually ended."]}],"\n"]}]
32:["$","h3","74",{"children":["Is this a Bug?"]}]
33:["$","p","76",{"children":[["$","strong","0",{"children":["No, this is intended behavior."]}],"\nGitLab and other major platforms document this: \"Session restoration is considered a trusted continuity signal.\""]}]
34:["$","p","78",{"children":["Forcing a logout in this scenario would disrupt the user experience, as the user explicitly requested to restore their previous state."]}]
35:["$","h3","80",{"children":["Is it Acceptable?"]}]
36:["$","p","82",{"children":[["$","strong","0",{"children":["Yes."]}]]}]
37:["$","ul","84",{"children":["\n",["$","li","1",{"children":[["$","strong","0",{"children":["Security Check"]}],": It typically occurs on the same device and browser instance."]}],"\n",["$","li","3",{"children":[["$","strong","0",{"children":["Industry Standard"]}],": It is standard behavior across most modern web applications."]}],"\n",["$","li","5",{"children":[["$","strong","0",{"children":["Mental Model"]}],": \"Remember Me\" controls persistence across fresh starts (cold opens), not session restorations."]}],"\n"]}]
